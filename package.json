{
  "name": "bible-projector",
  "version": "0.1.0",
  "private": true,
  "description": "圣言投屏：离线双窗圣经投屏（Electron 22 单基线，ADR-0001）",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=16.17.0"
  },
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run build:main && npm run build:renderer && npm run typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "start": "electron ."
  },
  "devDependencies": {
    "@types/node": "^16.18.0",
    "electron": "22.3.27",
    "eslint": "^9.10.0",
    "eslint-plugin-n": "^17.10.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "@types/node": "^16.18.0"
  }
}
