{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "ignoreDeprecations": "5.0",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": false,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/main/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["src/shared/font-dom.ts"]
}
