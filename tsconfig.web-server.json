{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "ignoreDeprecations": "5.0",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": false,
    "sourceMap": true,
    "outDir": "dist/web-server",
    "rootDir": "src"
  },
  "include": ["src/web/server.ts", "src/web/start.ts"],
  "exclude": ["src/web/bridge-client.ts"]
}